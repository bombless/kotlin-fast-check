{
  "name": "kotlin-fast-check",
  "version": "0.1.0",
  "description": "A lightweight Kotlin source semantic checker written in TypeScript.",
  "type": "module",
  "bin": {
    "kcheck": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bombless/kotlin-fast-check.git"
  },
  "homepage": "https://github.com/bombless/kotlin-fast-check#readme",
  "bugs": {
    "url": "https://github.com/bombless/kotlin-fast-check/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test:ci && npm run build",
    "test:ci": "vitest run --exclude tests/e2e/android-space-inspector.test.ts --exclude tests/project-discovery.test.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "tree-sitter": "^0.21.1",
    "tree-sitter-kotlin": "^0.3.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
